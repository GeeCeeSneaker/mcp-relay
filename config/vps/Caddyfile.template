# MCPRelay public TLS ingress (M4). Rendered into /etc/mcprelay/Caddyfile.
{
	admin off
	email <acme-email>
}

<mcp-domain> {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Gateway features MCPRelay does not use (DCR, upstream-OAuth backend
	# management, API docs) are not exposed publicly. Requests from the host
	# itself (operator tests) are exempt.
	@unused {
		not remote_ip 127.0.0.1 ::1
		path /openapi.json /docs /docs/* /redoc /ui/backends /ui/backends/* /auth/api/backends /auth/api/backends/* /oauth/connect/* /oauth/callback /oauth/client-metadata.json /register
	}
	respond @unused 404

	# Only allow-listed OAuth clients (the Owner's own ChatGPT connector) may
	# start an authorization. Blocks consent phishing via someone else's client.
<client-allowlist>
	# Ride out a gateway restart: retry the *connection* (never a sent request)
	# to the gateway for up to 15 s before failing the client's request.
	reverse_proxy 127.0.0.1:18000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
	log {
		output stderr
		format console
	}
}
