+def _persistent_client_factory(name: str, template: Client):
+    """Client factory that reuses ONE connected backend client (MCPRelay patch).
+
+    FastMCP proxies built from a disconnected Client open a fresh backend
+    connection for every request (era negotiation, and for handshake-era
+    backends initialize/initialized/GET/DELETE). Over a high-latency reverse
+    tunnel that dominated per-call latency. Here the first request connects a
+    copy of the configured client and later requests reuse it; a copy that has
+    disconnected is replaced. Copies keep the no-header-forwarding transport.
+    """
+    lock = asyncio.Lock()
+    current: list[Client] = []
+
+    async def factory() -> Client:
+        if current and current[0].is_connected():
+            return current[0]
+        async with lock:
+            if current and current[0].is_connected():
+                return current[0]
+            if current:
+                try:
+                    await current[0].__aexit__(None, None, None)
+                except Exception:  # noqa: BLE001 - stale client, best effort
+                    pass
+                current.clear()
+            client = template.new()
+            await client.__aenter__()
+            logger.info("Backend %s: persistent client connected (protocol %s)", name, client.protocol_version)
+            current.append(client)
+            return client
+
+    return factory
+
